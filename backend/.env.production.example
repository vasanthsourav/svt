# ── SVT-Shop PRODUCTION config ───────────────────────────────────────────────
# Copy to ".env" on your server and fill in. The site + API are served by ONE
# Node process (single-server hosting), so put HTTPS in front via Caddy/Nginx or
# your host (Render provides it automatically).

NODE_ENV=production
PORT=4100

# Your live domain(s). Same-origin serving means CORS isn't strictly needed, but
# list your domain here anyway.
CORS_ORIGINS=https://yourdomain.com

# Where the built storefront lives (default works with the repo layout).
CLIENT_DIR=../storefront/dist

# 🔐 CHANGE THIS to a long random string (e.g. `openssl rand -hex 32`).
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRES=30d

# Seeded admin account (created by `npm run db:seed`). Change the password!
ADMIN_EMAIL=admin@srivenkateshwaratextils.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
ADMIN_NAME=SVT Admin

# ── Razorpay (LIVE) — fill when you have your keys ───────────────────────────
# Leave BLANK to keep mock/test mode. Add both to accept real payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Phone OTP delivery — fill when you have an SMS gateway ────────────────────
# console = OTP printed to server log (no SMS). http = real SMS via any gateway.
OTP_PROVIDER=console
OTP_HTTP_URL=
OTP_HTTP_METHOD=POST
OTP_HTTP_HEADERS={"Content-Type":"application/json"}
OTP_HTTP_BODY={"to":"{phone}","message":"Your SVT OTP is {code}"}

# ── RazorpayX (affiliate auto-payouts) — optional, blank = manual payouts ─────
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=

# ── Misc ─────────────────────────────────────────────────────────────────────
INDIA_POST_TRACK_URL=https://www.indiapost.gov.in/_layouts/15/dop.portal.tracking/trackconsignment.aspx
AFFILIATE_COMMISSION_PERCENT=7

# On-disk DB backups
BACKUP_INTERVAL_MIN=60
BACKUP_KEEP=48
