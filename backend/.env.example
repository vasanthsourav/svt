# ── SVT-Shop backend configuration ───────────────────────────────────────────
# Copy this file to ".env" and fill in your values. Sensible defaults let the
# shop run end-to-end in DEV with NO external accounts (mock payments + console OTP).

# Server
PORT=4100
# Comma-separated list of allowed storefront origins (CORS)
CORS_ORIGINS=http://localhost:5180

# Auth — change JWT_SECRET to a long random string in production
JWT_SECRET=change-this-to-a-long-random-secret-string
JWT_EXPIRES=30d

# Seeded admin account (created by `npm run db:seed`)
ADMIN_EMAIL=admin@svttextils.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=SVT Admin

# ── Razorpay ─────────────────────────────────────────────────────────────────
# Leave the keys BLANK to run in MOCK mode (no real money; checkout auto-succeeds).
# Fill them with live/test keys from https://dashboard.razorpay.com to go live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── OTP delivery (phone login) ───────────────────────────────────────────────
# console = dev mode: the OTP is returned in the API response & printed to the
#           server log (no SMS sent). Great for testing.
# http    = send via any SMS/WhatsApp HTTP gateway (MSG91, Fast2SMS, WA Cloud…).
OTP_PROVIDER=console
# Used only when OTP_PROVIDER=http. {phone} and {code} are substituted.
OTP_HTTP_URL=
OTP_HTTP_METHOD=POST
OTP_HTTP_HEADERS={"Content-Type":"application/json"}
OTP_HTTP_BODY={"to":"{phone}","message":"Your SVT OTP is {code}"}

# India Post manual tracking link (consignment number appended)
INDIA_POST_TRACK_URL=https://www.indiapost.gov.in/_layouts/15/dop.portal.tracking/trackconsignment.aspx
